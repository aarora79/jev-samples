# Scratchpad: local planning notes, never committed
.scratchpad/

# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Virtual environments and secrets
.venv/
.env

# Tool caches
.ruff_cache/
.mypy_cache/
.pytest_cache/
.coverage

# Readiness reports land in samples/agents-md-readiness/data/ and are committed:
# they are the runs behind the table in that sample's README. Strays elsewhere
# in the sample folder are not.
samples/agents-md-readiness/*.json

# Cross-compiled binaries from samples/agents-md-readiness/go/build.sh. Releases
# carry them; the repo does not.
samples/agents-md-readiness/go/dist/

# OS
.DS_Store
