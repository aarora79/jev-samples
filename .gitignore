# Scratchpad: local planning notes, never committed
.scratchpad/

# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Virtual environments and secrets
.venv/
.env

# Tool caches
.ruff_cache/
.mypy_cache/
.pytest_cache/
.coverage

# Readiness reports land in samples/agents-md-readiness/data/ and are committed:
# they are the runs behind the table in that sample's README. Strays elsewhere
# in the sample folder are not, and neither is this repo scoring itself, which a
# local run writes on every invocation and the README's table does not count.
samples/agents-md-readiness/*.json
samples/agents-md-readiness/data/jev-samples-agents-md.json

# pr-triage writes three files per selector: a dataset, a JSON triage report and a
# markdown one. The repo keeps the apache/airflow reports as the worked example and
# drops the rest. Datasets stay out because one command rebuilds them
# (`uv run fetch_prs.py owner/repo --all`) and one mirrors 26 contributors' diffs at
# a couple of megabytes. Reports for other repositories stay out because triaging
# somebody's open pull requests is their business rather than this repo's, and
# because a --since window names a date that is stale the next day. Allowing one
# name keeps the invariant visible: the committed reports are the runs behind the
# README's numbers.
samples/pr-triage/data/*
!samples/pr-triage/data/apache-airflow-open-latest-18-triage.json
!samples/pr-triage/data/apache-airflow-open-latest-18-triage.md

# Compiled binaries from samples/agents-md-readiness/go/. build.sh writes dist/,
# `go build -o agents-md-readiness .` writes that name beside the source, and a
# plain `go build` names its output after the directory, which is `go`. A release
# carries the binaries; the repo carries the source.
samples/agents-md-readiness/go/dist/
samples/agents-md-readiness/go/agents-md-readiness
samples/agents-md-readiness/go/go
samples/pr-triage/go/dist/
samples/pr-triage/go/pr-triage
samples/pr-triage/go/go
*.exe

# OS
.DS_Store
